+    /// Use exactly the supplied endpoint pool. Embedded consumers must not
+    /// inherit unrelated environment endpoints or an implicit mainnet fallback.
+    pub fn from_explicit_rpc_clients(
+        clients: Vec<Arc<RpcClient>>,
+        cluster: SolanaCluster,
+    ) -> anyhow::Result<Self> {
+        let mut seen = HashSet::new();
+        let clients: Vec<_> = clients
+            .into_iter()
+            .filter(|rpc| seen.insert(rpc.url()))
+            .collect();
+        let primary = clients.first().context("RPC pool is empty")?.clone();
+        Ok(Self {
+            rpc_client: primary,
+            cluster,
+            read_rpc_clients: Arc::new(clients),
+        })
+    }
+
     pub fn from_rpc_client(rpc_client: Arc<RpcClient>) -> Self {
         Self::from_rpc_pool_with_cluster(
             rpc_client.clone(),
@@ -736,6 +755,107 @@ impl SolHook {
         }
     }
 
+    /// Filtered program-account scans with provider capability failover and
+    /// Helius pagination. Some free endpoints accept reads but reject indexes.
+    pub async fn get_program_accounts_json_resilient(
+        &self,
+        program: &Pubkey,
+        options: serde_json::Value,
+    ) -> anyhow::Result<Vec<serde_json::Value>> {
+        use serde_json::json;
+        let http = reqwest::Client::builder()
+            .timeout(Duration::from_secs(15))
+            .build()?;
+        let mut last_error =
+            anyhow::anyhow!("no RPC endpoints available for program-account lookup");
+        for rpc in self.read_rpc_clients_for_attempts("getProgramAccounts") {
+            let mut method = "getProgramAccounts";
+            let mut cursor: Option<String> = None;
+            let mut accounts = Vec::new();
+            for page in 0..=100 {
+                let mut params = options.clone();
+                if method == "getProgramAccountsV2" {
+                    params["limit"] = json!(1000);
+                    if let Some(key) = cursor.as_ref() {
+                        params["paginationKey"] = json!(key);
+                    }
+                }
+                let response = match http
+                    .post(rpc.url())
+                    .json(&json!({
+                        "jsonrpc":"2.0", "id":1, "method":method,
+                        "params":[program.to_string(),params],
+                    }))
+                    .send()
+                    .await
+                {
+                    Ok(response) => response,
+                    Err(error) => {
+                        last_error = error.into();
+                        break;
+                    }
+                };
+                let status = response.status();
+                let body: serde_json::Value = match response.json().await {
+                    Ok(body) => body,
+                    Err(error) => {
+                        last_error = error.into();
+                        break;
+                    }
+                };
+                if !status.is_success() || body.get("error").is_some_and(|v| !v.is_null()) {
+                    let message = body
+                        .get("error")
+                        .map(ToString::to_string)
+                        .unwrap_or_else(|| status.to_string());
+                    let lower = message.to_ascii_lowercase();
+                    if method == "getProgramAccounts"
+                        && (lower.contains("getprogramaccountsv2")
+                            || lower.contains("too many accounts requested"))
+                    {
+                        method = "getProgramAccountsV2";
+                        continue;
+                    }
+                    last_error = anyhow::anyhow!(
+                        "program-account lookup rejected by provider: {}",
+                        Self::redact_url_queries_in_text(&message)
+                    );
+                    break;
+                }
+                if method == "getProgramAccounts" {
+                    match body.get("result").and_then(|v| v.as_array()) {
+                        Some(entries) => return Ok(entries.clone()),
+                        None => {
+                            last_error = anyhow::anyhow!("invalid getProgramAccounts response");
+                            break;
+                        }
+                    }
+                }
+                let result = &body["result"];
+                let Some(entries) = result["accounts"].as_array() else {
+                    last_error = anyhow::anyhow!("invalid paginated program-account response");
+                    break;
+                };
+                accounts.extend(entries.iter().cloned());
+                let next = result["paginationKey"]
+                    .as_str()
+                    .filter(|v| !v.is_empty())
+                    .map(str::to_owned);
+                if next.is_none() {
+                    return Ok(accounts);
+                }
