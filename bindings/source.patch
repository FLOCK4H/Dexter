+//! Thin build-only Python bindings. Protocol layouts and quotes stay in dex/.
+use crate::core::{
+    cluster::SolanaCluster,
+    sol::{PriorityFeeOverride, SolHook, WSOL_MINT},
+};
+use crate::dex::{
+    pump_fun::{PumpFun, PumpFunEvent},
+    pump_swap::PumpSwap,
+    swaps::{Market, MintPoolRoute, Swaps},
+};
+use anyhow::{Context, ensure};
+use base64::{Engine as _, engine::general_purpose::STANDARD as B64};
+use pyo3::{exceptions::PyValueError, prelude::*};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use solana_client::nonblocking::rpc_client::RpcClient;
+use solana_keypair::Keypair;
+use solana_program::{instruction::Instruction, pubkey::Pubkey};
+use std::{str::FromStr, sync::Arc, time::Duration};
+use tokio::runtime::{Builder, Runtime};
+
+#[derive(Deserialize)]
+struct Request {
+    op: String,
+    name: Option<String>,
+    symbol: Option<String>,
+    uri: Option<String>,
+    mint: Option<String>,
+    user: Option<String>,
+    pool: Option<String>,
+    market_priority: Option<String>,
+    side: Option<String>,
+    lamports: Option<u64>,
+    token_amount_raw: Option<u64>,
+    sell_pct: Option<u64>,
+    slippage_pct: Option<f64>,
+    priority_micro_lamports: Option<u64>,
+}
+
+fn key(value: Option<&str>, label: &str) -> anyhow::Result<Pubkey> {
+    Pubkey::from_str(value.context(format!("{label} is required"))?)
+        .with_context(|| format!("invalid {label} public key"))
+}
+
+#[pyclass(frozen)]
+struct Client {
+    runtime: Runtime,
+    swaps: Swaps,
+}
+
+#[pymethods]
+impl Client {
+    #[new]
+    fn new(rpc_urls: &str) -> PyResult<Self> {
+        crate::utils::writing::mute_logs();
+        let urls: Vec<_> = rpc_urls
+            .split(',')
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .collect();
+        if urls.is_empty()
+            || urls
+                .iter()
+                .any(|url| !(url.starts_with("https://") || url.starts_with("http://")))
+        {
+            return Err(PyValueError::new_err(
+                "at least one HTTP RPC URL is required",
+            ));
+        }
+        let runtime = Builder::new_multi_thread()
+            .worker_threads(2)
+            .enable_all()
+            .build()
+            .map_err(|_| PyValueError::new_err("cannot start Mamba async runtime"))?;
+        let swaps = {
+            let _guard = runtime.enter();
+            let clients: Vec<_> = urls
+                .iter()
+                .map(|url| {
+                    Arc::new(RpcClient::new_with_timeout(
+                        (*url).to_owned(),
+                        Duration::from_secs(15),
+                    ))
+                })
+                .collect();
+            let checked = runtime.block_on(futures::future::join_all(clients.into_iter().map(
+                |rpc| async move {
+                    let genesis = rpc.get_genesis_hash().await;
+                    (rpc, genesis)
+                },
+            )));
+            let first_hash = checked
+                .iter()
+                .find_map(|(_, hash)| hash.as_ref().ok())
+                .copied()
+                .ok_or_else(|| PyValueError::new_err("cannot verify the SDK RPC cluster"))?;
+            if checked
+                .iter()
+                .any(|(_, hash)| hash.as_ref().is_ok_and(|hash| *hash != first_hash))
+            {
+                return Err(PyValueError::new_err(
+                    "SDK RPC endpoints belong to different Solana clusters",
+                ));
+            }
+            let cluster = SolanaCluster::from_genesis_hash(&first_hash.to_string());
+            let clients = checked
+                .into_iter()
+                .filter_map(|(rpc, hash)| hash.ok().map(|_| rpc))
+                .collect();
+            let sol = SolHook::from_explicit_rpc_clients(clients, cluster)
+                .map_err(|_| PyValueError::new_err("cannot initialize SDK RPC pool"))?;
+            // SDK constructors require a keypair; every build below explicitly
+            // supplies the caller's PUBLIC key. No private key enters this module.
+            let placeholder = Arc::new(Keypair::new());
+            Swaps::new(
+                sol.clone(),
+                PumpSwap::new(placeholder.clone(), Arc::new(sol.clone())),
+                PumpFun::new(placeholder, Arc::new(sol)),
+            )
+        };
+        Ok(Self { runtime, swaps })
+    }
+
+    fn request_json(&self, py: Python<'_>, payload: String) -> PyResult<String> {
+        let request: Request = serde_json::from_str(&payload)
+            .map_err(|_| PyValueError::new_err("invalid Mamba SDK request"))?;
+        py.allow_threads(|| self.runtime.block_on(self.dispatch(request)))
+            .and_then(|value| serde_json::to_string(&value).map_err(Into::into))
+            .map_err(|error| {
+                PyValueError::new_err(SolHook::redacted_error(&anyhow::anyhow!("{error:#}")))
+            })
+    }
+}
+
+impl Client {
+    async fn route(&self, req: &Request) -> anyhow::Result<MintPoolRoute> {
+        let mint = req.mint.as_ref().context("mint is required")?;
+        let markets = req
+            .market_priority
+            .as_deref()
+            .map(Market::parse_csv)
+            .transpose()?;
+        let quote = WSOL_MINT.to_string();
+        self.swaps
+            .find_pool_for_mint_with_market_priority(mint, Some(&quote), 0, markets.as_deref())
+            .await?
+            .context("route_unavailable_or_migration_pending")
+    }
+
+    async fn dispatch(&self, req: Request) -> anyhow::Result<Value> {
+        match req.op.as_str() {
+            "route" => {
+                let route = self.route(&req).await?;
+                let price = self
+                    .swaps
+                    .fetch_price_for_market_pool(route.market, &route.pool)
+                    .await?;
+                Ok(
+                    json!({"market": route.market.as_str(), "pool": route.pool.to_string(),
+                    "creator": route.creator.to_string(), "price": price}),
+                )
+            }
+            "pool_state" | "snapshot" => {
+                let pool = key(req.pool.as_deref(), "pool")?;
+                let state = self.swaps.pump_swap.fetch_state(&pool).await?;
+                let mut result = json!({"pool": pool.to_string(), "creator": state.creator.to_string(),
+                    "base_mint": state.base_mint.to_string(), "quote_mint": state.quote_mint.to_string(),
+                    "lp_mint": state.lp_mint.to_string(), "lp_supply": state.lp_supply,
+                    "pool_base_token_account": state.pool_base_token_account.to_string(),
+                    "pool_quote_token_account": state.pool_quote_token_account.to_string(),
+                    "coin_creator": state.coin_creator.to_string(), "is_mayhem_mode": state.is_mayhem_mode});
+                if req.op == "snapshot" {
+                    ensure!(
+                        state.quote_mint.to_bytes() == WSOL_MINT.to_bytes(),
+                        "pool is not SOL quoted"
+                    );
+                    let base = Pubkey::new_from_array(state.pool_base_token_account.to_bytes());
+                    let quote = Pubkey::new_from_array(state.pool_quote_token_account.to_bytes());
+                    let ((base_raw, decimals), (quote_raw, _)) = tokio::try_join!(
+                        self.swaps.sol_hook.get_token_balance_raw_from_ata(&base),
+                        self.swaps.sol_hook.get_token_balance_raw_from_ata(&quote)
+                    )?;
+                    ensure!(base_raw > 0 && quote_raw > 0, "pool has no liquidity");
+                    let effective = self
+                        .swaps
+                        .pump_swap
+                        .effective_quote_reserves(&pool, quote_raw)
+                        .await?;
+                    result["effective_quote_reserves_raw"] = json!(effective);
+                    result["base_reserves_raw"] = json!(base_raw);
+                    result["quote_reserves_raw"] = json!(quote_raw);
+                    result["base_decimals"] = json!(decimals);
+                    result["price"] = json!(
+                        (effective as f64 / 1e9) / (base_raw as f64 / 10_f64.powi(decimals as i32))
+                    );
+                    result["liquidity_sol"] = json!(quote_raw as f64 / 1e9);
+                }
+                Ok(result)
+            }
+            "curve" => {
+                let pool = match req.pool.as_deref() {
+                    Some(pool) => Pubkey::from_str(pool)?,
+                    None => {
+                        PumpFun::derive_bonding_curve(&key(req.mint.as_deref(), "mint")?).await?
+                    }
+                };
+                let state = self.swaps.pump_fun.fetch_state(&pool).await?;
+                Ok(
+                    json!({"pool": pool.to_string(), "creator": state.creator.to_string(),
+                    "complete": state.complete, "virtual_sol_reserves": state.virtual_sol_reserves,
+                    "virtual_token_reserves": state.virtual_token_reserves,
+                    "real_sol_reserves": state.real_sol_reserves, "real_token_reserves": state.real_token_reserves,
+                    "token_total_supply": state.token_total_supply,
+                    "is_mayhem_mode": state.is_mayhem_mode, "is_cashback_coin": state.is_cashback_coin}),
+                )
+            }
+            "quote_buy" => {
+                let mint = key(req.mint.as_deref(), "mint")?;
+                let amount = req.lamports.context("lamports is required")?;
+                ensure!(amount > 0, "buy amount must be positive");
+                Ok(
+                    json!({"token_amount_raw": self.swaps.pump_fun.quote_buy_for_mint(&mint, amount).await?}),
+                )
+            }
+            "token_balance" => {
+                let mint = key(req.mint.as_deref(), "mint")?;
+                let user = key(req.user.as_deref(), "user")?;
+                let ata = self.swaps.sol_hook.get_ata_auto(&user, &mint).await?;
+                if self
+                    .swaps
+                    .sol_hook
+                    .get_account_optional(&ata)
+                    .await?
+                    .is_none()
+                {
+                    return Ok(
+                        json!({"amount": 0, "decimals": self.swaps.sol_hook.get_token_decimals(&mint).await?}),
+                    );
+                }
+                let (amount, decimals) = self
+                    .swaps
+                    .sol_hook
+                    .get_token_balance_raw_from_ata(&ata)
+                    .await?;
+                Ok(json!({"amount": amount, "decimals": decimals}))
+            }
+            "build" => self.build(&req).await,
+            "create" => {
+                let payer = key(req.user.as_deref(), "user")?;
+                let mint = key(req.mint.as_deref(), "mint")?;
+                let create = crate::core::create::PumpFunCreatePlan {
+                    payer,
+                    mint,
+                    name: req.name.context("name is required")?,
+                    symbol: req.symbol.context("symbol is required")?,
+                    uri: req.uri.context("uri is required")?,
+                    is_mayhem_mode: false,
+                };
+                let (plan, mayhem, expected) = self
+                    .swaps
+                    .pump_fun
+                    .plan_launch_for_user(
+                        create,
+                        req.lamports.unwrap_or(0),
+                        req.slippage_pct.unwrap_or(15.0),
+                    )
+                    .await?;
+                let derived: serde_json::Map<String, Value> = plan
+                    .derived
+                    .map
+                    .iter()
+                    .map(|(name, address)| (name.clone(), json!(address.to_string())))
+                    .collect();
+                Ok(
+                    json!({"market":"pump_fun", "mint":mint.to_string(), "owner":payer.to_string(),
+                    "token_program":if mayhem {crate::core::sol::TOKEN_2022_PROGRAM_ID.to_string()} else {crate::core::sol::TOKEN_PROGRAM_ID.to_string()},
+                    "is_mayhem_mode":mayhem, "create_variant":if mayhem {"create_v2"} else {"create"},
+                    "derived":derived, "expected_tokens_out":expected, "compute_units":800000,
+                    "priority_micro_lamports":req.priority_micro_lamports.unwrap_or(0),
+                    "instructions":plan.instructions.iter().map(instruction_json).collect::<Vec<_>>()}),
+                )
+            }
+            _ => anyhow::bail!("unsupported Mamba SDK operation"),
+        }
+    }
+
+    async fn build(&self, req: &Request) -> anyhow::Result<Value> {
+        let user = key(req.user.as_deref(), "user")?;
+        let mint = key(req.mint.as_deref(), "mint")?;
+        let side = req.side.as_deref().context("side is required")?;
+        ensure!(side == "buy" || side == "sell", "side must be buy or sell");
+        let slippage = req.slippage_pct.unwrap_or(5.0);
+        ensure!(
+            slippage.is_finite() && slippage > 0.0 && slippage < 100.0,
+            "invalid slippage percentage"
+        );
+        let pct = req.sell_pct.unwrap_or(100);
+        ensure!((1..=100).contains(&pct), "invalid sell percentage");
+        if side == "buy" {
+            ensure!(req.lamports.unwrap_or(0) > 0, "buy amount must be positive");
+        }
+        if let Some(amount) = req.token_amount_raw {
+            ensure!(amount > 0, "sell amount must be positive");
+        }
+        // Resolve from current chain state on EVERY build, including recovered
+        // positions and a sell whose original buy used the bonding curve.
+        let route = self.route(req).await?;
+        let price = self
+            .swaps
+            .fetch_price_for_market_pool(route.market, &route.pool)
+            .await?;
+        let fee = req.priority_micro_lamports.unwrap_or(0);
+        let fee_override = Some(PriorityFeeOverride::ExactMicroLamports(fee));
+        let (instructions, _) = match (side, route.market) {
+            ("buy", Market::PumpFun) => {
+                self.swaps
+                    .pump_fun
+                    .buy_for_user_with_priority_fee_override(
+                        &user,
+                        &mint,
+                        &route.pool,
+                        &route.creator,
+                        req.lamports.unwrap_or(0) as f64 / 1e9,
+                        slippage,
+                        price,
+                        Some(true),
+                        fee_override,
+                    )
+                    .await?
+            }
+            ("buy", Market::PumpSwap) => {
+                self.swaps
+                    .pump_swap
+                    .buy_for_user_with_priority_fee_override(
+                        &user,
+                        &mint,
+                        &route.pool,
+                        &route.creator,
+                        req.lamports.unwrap_or(0) as f64 / 1e9,
+                        slippage,
+                        price,
+                        Some(true),
+                        fee_override,
+                    )
+                    .await?
+            }
+            ("sell", Market::PumpFun) => {
+                self.swaps
+                    .pump_fun
+                    .sell_for_user_with_amount(
+                        &user,
+                        &mint,
+                        &route.pool,
+                        &route.creator,
+                        pct,
+                        slippage,
+                        price,
+                        fee_override,
+                        req.token_amount_raw,
+                    )
+                    .await?
+            }
+            ("sell", Market::PumpSwap) => {
+                self.swaps
+                    .pump_swap
+                    .sell_for_user_with_amount(
+                        &user,
+                        &mint,
+                        &route.pool,
+                        &route.creator,
+                        pct,
+                        slippage,
+                        price,
+                        fee_override,
+                        req.token_amount_raw,
+                    )
+                    .await?
+            }
+            ("buy", _) => {
+                self.swaps
+                    .build_buy_instructions_for_user(
+                        &user,
+                        &mint,
+                        &route.pool,
+                        &route.creator,
+                        req.lamports.unwrap_or(0) as f64 / 1e9,
+                        slippage,
+                        price,
+                        Some(true),
+                        route.market,
+                    )
+                    .await?
+            }
+            _ => {
+                let pct = if let Some(amount) = req.token_amount_raw {
+                    let (balance, _) = self
+                        .swaps
+                        .sol_hook
+                        .get_token_balance_raw(&user, &mint)
+                        .await?;
+                    ensure!(
+                        amount <= balance && balance > 0,
+                        "sell amount exceeds wallet balance"
+                    );
+                    (1..=100).find(|pct| balance.saturating_mul(*pct)/100 == amount)
+                        .context("this market cannot represent the exact partial position with an integer percentage")?
+                } else {
+                    pct
+                };
+                self.swaps
+                    .build_sell_instructions_for_user(
+                        &user,
+                        &mint,
+                        &route.pool,
+                        &route.creator,
+                        pct,
+                        slippage,
+                        price,
+                        route.market,
+                    )
+                    .await?
+            }
+        };
+        Ok(
+            json!({"market": route.market.as_str(), "pool": route.pool.to_string(),
+            "creator": route.creator.to_string(), "price": price, "priority_micro_lamports": fee,
+            "instructions": instructions.iter().map(instruction_json).collect::<Vec<_>>()}),
+        )
+    }
+}
+
+fn instruction_json(ix: &Instruction) -> Value {
+    json!({"program_id": ix.program_id.to_string(), "data": B64.encode(&ix.data),
+        "accounts": ix.accounts.iter().map(|a| json!({"pubkey": a.pubkey.to_string(),
+            "is_signer": a.is_signer, "is_writable": a.is_writable})).collect::<Vec<_>>()})
+}
+
+#[pyfunction]
+fn markets() -> Vec<&'static str> {
+    Swaps::default_market_priority()
+        .iter()
+        .map(Market::as_str)
+        .collect()
+}
+
+#[pyfunction]
+fn derive_pump_curve(mint: &str) -> PyResult<(String, u8)> {
+    let mint =
+        key(Some(mint), "mint").map_err(|_| PyValueError::new_err("invalid mint public key"))?;
+    let (pool, bump) = PumpFun::derive_bonding_curve_with_bump(&mint);
+    Ok((pool.to_string(), bump))
+}
+
+#[pyfunction]
+fn decode_pump_log(payload: &str, kind: &str) -> PyResult<Option<String>> {
+    let logs = [format!("Program data: {payload}")];
+    for event in PumpFun::parse_logs(logs.iter(), None) {
+        let value = match event {
+            PumpFunEvent::Trade(Some(e)) if kind == "trade" => json!({
+                "mint": e.mint.to_string(), "user": e.user.to_string(),
+                "sol_amount": e.sol_amount, "token_amount": e.token_amount,
+                "is_buy": e.is_buy, "timestamp": e.timestamp,
+                "virtual_sol_reserves": e.virtual_sol_reserves,
+                "virtual_token_reserves": e.virtual_token_reserves}),
+            PumpFunEvent::Create(Some(e)) if kind == "create" => json!({
+                "mint": e.mint.to_string(), "user": e.creator.to_string(),
+                "creator": e.creator.to_string(), "name": e.name, "symbol": e.symbol,
+                "uri": e.uri, "bonding_curve": e.bonding_curve.to_string()}),
+            _ => continue,
+        };
+        return Ok(Some(value.to_string()));
+    }
+    Ok(None)
+}
+
+#[pymodule]
+fn _native(m: &Bound<'_, PyModule>) -> PyResult<()> {
+    m.add_class::<Client>()?;
+    m.add_function(wrap_pyfunction!(markets, m)?)?;
+    m.add_function(wrap_pyfunction!(decode_pump_log, m)?)?;
+    m.add_function(wrap_pyfunction!(price_from_logs, m)?)?;
+    m.add_function(wrap_pyfunction!(derive_pump_curve, m)?)?;
+    Ok(())
+}
+
+#[pyfunction]
+fn price_from_logs(logs: Vec<String>) -> Option<f64> {
+    for event in PumpFun::parse_logs(logs.iter(), None) {
+        if let PumpFunEvent::Trade(Some(trade)) = event {
+            let price = PumpFun::get_price(&trade);
+            if price.is_finite() && price > 0.0 {
+                return Some(price);
+            }
+        }
+    }
+    for log in &logs {
+        if let Some(price) = PumpSwap::price_from_log_line(log) {
+            return Some(price);
+        }
+    }
+    None
+}
