+        data.extend_from_slice(&2_000_000_000_i128.to_le_bytes());
+        let boosted = format!("Program data: {}", B64.encode(&data));
+        assert_eq!(PumpSwap::price_from_log_line(&boosted), Some(3.0));
+        data[offset..].copy_from_slice(&(-200_000_000_i128).to_le_bytes());
+        let accrued_fees = format!("Program data: {}", B64.encode(&data));
+        assert_eq!(PumpSwap::price_from_log_line(&accrued_fees), Some(0.8));
+    }
