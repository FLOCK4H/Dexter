+"""Native, build-only access to Mamba's Rust market modules.
+
+The SDK does not accept private keys or submit transactions. Applications own
+signing, simulation, send authorization, confirmation, and spend limits.
+"""
+
+import asyncio
+import json
+
+from ._native import Client as NativeClient, decode_pump_log, derive_pump_curve, markets, price_from_logs
+
+
+class Client:
+    def __init__(self, rpc_urls: str):
+        self._native = NativeClient(rpc_urls)
+
+    async def request(self, operation: str, **params):
+        payload = json.dumps({"op": operation, **params}, allow_nan=False)
+        result = await asyncio.to_thread(self._native.request_json, payload)
+        return json.loads(result)
+
+
+__all__ = ["Client", "markets"]
diff --git a/scripts/prepare_python_build.py b/scripts/prepare_python_build.py
new file mode 100644
index 0000000000000000000000000000000000000000..696be54e4aa493b7db386cff3d2ad7fd348fd5af
--- /dev/null
+++ b/scripts/prepare_python_build.py
@@ -0,0 +1,50 @@
+"""Fetch only missing, pinned IDLs required to compile the native SDK.
+
+Uses the existing upstream lock; does not update dependencies or Git remotes.
+Full upstream mirrors from sync_sources.sh remain supported.
+"""
+import json
+from pathlib import Path
+import re
+import urllib.request
+
+ROOT = Path(__file__).resolve().parents[1]
+INPUTS = {
+    'raydium_docs': 'public/launchpad_creator_fee_upgrade/raydium_launchpad.json',
+    'meteora_dlmm_sdk': 'idls/dlmm.json',
+}
+TEST_INPUTS = {
+    'damm-v1-sdk': 'dynamic-amm-quote/tests/fixtures/accounts/HcjZvfeSNJbNkfLD4eEcRBr96AD3w1GpmMppaeRZf7ur.json',
+    'meteora_dlmm_sdk': 'commons/tests/fixtures/B5Eia4cE71tKuEDaqPHucJLG2fxySKyKzLMewd2nUvoc/lb_pair.bin',
+}
+
+
+def main():
+    import sys
+    lock = (ROOT / 'UPSTREAM_SOURCES.lock').read_text(encoding='utf-8')
+    inputs = list(INPUTS.items()) + (list(TEST_INPUTS.items()) if '--tests' in sys.argv else [])
+    for name, relative in inputs:
+        target = ROOT / 'external' / 'upstreams' / name / relative
+        if target.exists():
+            continue
+        pattern = rf'^\| {re.escape(name)} \| https://github.com/([^ ]+)\.git \| [^|]+ \| ([0-9a-f]{{40}}) \|$'
+        match = re.search(pattern, lock, re.MULTILINE)
+        if not match:
+            raise RuntimeError(f'Pinned source is missing for {name}')
+        repository, commit = match.groups()
+        url = f'https://raw.githubusercontent.com/{repository}/{commit}/{relative}'
+        with urllib.request.urlopen(url, timeout=60) as response:
+            data = response.read()
+        if relative in INPUTS.values():
+            parsed = json.loads(data)
+            if not parsed.get('instructions') or not parsed.get('types'):
+                raise RuntimeError(f'Invalid IDL for {name}')
+        elif not data:
+            raise RuntimeError(f'Empty test fixture for {name}')
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+        print(f'Prepared {name} IDL at pinned commit {commit[:12]}')
+
+
+if __name__ == '__main__':
+    main()
