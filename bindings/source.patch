+        let mut cursor = Cursor::new(&account_data[8..]);
+        let _ = Pool::deserialize_reader(&mut cursor)?;
+        let offset = 8 + cursor.position() as usize + 1; // is_cashback_coin
+        let virtual_quote = if account_data.len() <= offset {
+            0
+        } else {
+            let bytes: [u8; 16] = account_data
+                .get(offset..offset + 16)
+                .context("truncated pool virtual quote reserves")?
+                .try_into()?;
+            i128::from_le_bytes(bytes)
+        };
+        let effective = i128::from(raw)
+            .checked_add(virtual_quote)
+            .context("effective quote reserve overflow")?;
+        anyhow::ensure!(
+            (0..=i128::from(u64::MAX)).contains(&effective),
+            "effective quote reserves out of range"
+        );
+        Ok(effective as u64)
+    }
