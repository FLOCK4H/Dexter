index 0000000000000000000000000000000000000000..29f865d43c2e8be86b4d57dc5d7c675861f426a9
--- /dev/null
+++ b/src/core/program_accounts_tests.rs
@@ -0,0 +1,128 @@
+use super::cluster::SolanaCluster;
+use super::sol::SolHook;
+use axum::{Json, Router, routing::post};
+use serde_json::{Value, json};
+use solana_client::nonblocking::rpc_client::RpcClient;
+use solana_program::pubkey::Pubkey;
+use std::sync::Arc;
+
+#[tokio::test]
+async fn optional_token_account_uses_binary_encoding_and_confirmed_commitment() {
+    let (url, task) = server(Router::new().route(
+        "/",
+        post(|Json(request): Json<Value>| async move {
+            assert_eq!(request["params"][1]["encoding"], "base64");
+            assert_eq!(request["params"][1]["commitment"], "confirmed");
+            Json(
+                json!({"jsonrpc":"2.0","id":request["id"],"result":{"context":{"slot":1},"value":{
+            "lamports":100,"data":["AP8=","base64"],
+            "owner":"TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb",
+            "executable":false,"rentEpoch":0,"space":2}}}),
+            )
+        }),
+    ))
+    .await;
+    let sol = SolHook::from_explicit_rpc_clients(
+        vec![Arc::new(RpcClient::new(url))],
+        SolanaCluster::Unknown,
+    )
+    .unwrap();
+    let account = sol
+        .get_account_optional(&Pubkey::new_unique())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(account.data, vec![0, 255]);
+    task.abort();
+}
+
+async fn server(router: Router) -> (String, tokio::task::JoinHandle<()>) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let handle = tokio::spawn(async move {
+        axum::serve(listener, router).await.unwrap();
+    });
+    (url, handle)
+}
+
+#[tokio::test]
+async fn program_accounts_fails_over_after_free_plan_index_rejection() {
+    let (first, first_task) = server(Router::new().route(
+        "/",
+        post(|| async {
+            Json(json!({"jsonrpc":"2.0","id":1,"error":"IndexNotAllowedOnFreePlan"}))
+        }),
+    ))
+    .await;
+    let (second, second_task) = server(Router::new().route(
+        "/",
+        post(|| async { Json(json!({"jsonrpc":"2.0","id":1,"result":[{"pubkey":"found-pool"}]})) }),
+    ))
+    .await;
+    let first = Arc::new(RpcClient::new(first));
+    let sol = SolHook::from_explicit_rpc_clients(
+        vec![first, Arc::new(RpcClient::new(second))],
+        SolanaCluster::Unknown,
+    )
+    .unwrap();
+    let entries = sol
+        .get_program_accounts_json_resilient(&Pubkey::new_unique(), json!({"encoding":"base64"}))
+        .await
+        .unwrap();
+    assert_eq!(entries[0]["pubkey"], "found-pool");
+    first_task.abort();
+    second_task.abort();
+}
+
+#[tokio::test]
+async fn program_accounts_accumulates_paginated_results() {
+    let (url, task) = server(Router::new().route("/", post(|Json(request):Json<Value>| async move {
+        let result = if request["method"] == "getProgramAccounts" {
+            json!({"error":{"code":-32600,"message":"use getProgramAccountsV2 with pagination"}})
+        } else if request["params"][1]["paginationKey"].is_null() {
+            json!({"result":{"accounts":[{"pubkey":"first"}],"paginationKey":"page-two"}})
+        } else {
+            assert_eq!(request["params"][1]["paginationKey"], "page-two");
+            json!({"result":{"accounts":[{"pubkey":"second"}]}})
+        };
+        Json(result)
+    }))).await;
+    let sol = SolHook::from_explicit_rpc_clients(
+        vec![Arc::new(RpcClient::new(url))],
+        SolanaCluster::Unknown,
+    )
+    .unwrap();
+    let entries = sol
+        .get_program_accounts_json_resilient(&Pubkey::new_unique(), json!({"encoding":"base64"}))
+        .await
+        .unwrap();
+    assert_eq!(entries.len(), 2);
+    assert_eq!(entries[1]["pubkey"], "second");
+    task.abort();
+}
+
+#[tokio::test]
+async fn program_accounts_rejects_repeated_cursor_instead_of_returning_partial_results() {
+    let (url, task) = server(Router::new().route(
+        "/",
+        post(|Json(request): Json<Value>| async move {
+            Json(if request["method"] == "getProgramAccounts" {
+                json!({"error":{"message":"use getProgramAccountsV2"}})
+            } else {
+                json!({"result":{"accounts":[{"pubkey":"incomplete"}],"paginationKey":"same-page"}})
+            })
+        }),
+    ))
+    .await;
+    let sol = SolHook::from_explicit_rpc_clients(
+        vec![Arc::new(RpcClient::new(url))],
+        SolanaCluster::Unknown,
+    )
+    .unwrap();
+    let error = sol
+        .get_program_accounts_json_resilient(&Pubkey::new_unique(), json!({}))
+        .await
+        .unwrap_err();
+    assert!(error.to_string().contains("refusing partial results"));
+    task.abort();
+}
